--- a/src/loader_so.c
+++ b/src/loader_so.c
@@ -1557,7 +1557,28 @@
     size_t _copied = 0;
     for (int i = 0; i < eh->e_phnum; i++) {
         if (ph[i].p_type != PT_LOAD) continue;
-        memcpy((char*)base + (ph[i].p_vaddr - minv), (char*)map + ph[i].p_offset, ph[i].p_filesz);
+        /* Isolated pilot for the audited amdxc64 build. Map only aligned,
+         * complete immutable file pages inside our own reservation. Keep
+         * writable segments and partial pages on the original copy path. */
+        size_t mapped = 0;
+        size_t at = ph[i].p_vaddr - minv;
+        if (!strcmp(libshort(path), "amdxc64.so") && sysconf(_SC_PAGESIZE) == 4096 &&
+            (ph[i].p_flags == PF_R || ph[i].p_flags == (PF_R|PF_X)) &&
+            !(at & 4095) && !(ph[i].p_offset & 4095) && at <= mapsize &&
+            ph[i].p_filesz <= mapsize-at && ph[i].p_offset <= (uint64_t)st.st_size &&
+            ph[i].p_filesz <= (uint64_t)st.st_size-ph[i].p_offset) {
+            size_t n = ph[i].p_filesz & ~(size_t)4095;
+            void *dest = (char*)base + at;
+            int prot = PROT_READ | ((ph[i].p_flags & PF_X) ? PROT_EXEC : 0);
+            if (n && mmap(dest, n, prot, MAP_PRIVATE|MAP_FIXED, fd, ph[i].p_offset) == dest)
+                mapped = n;
+            else if (n && mmap(dest, n, PROT_READ|PROT_WRITE|PROT_EXEC,
+                               MAP_PRIVATE|MAP_FIXED|MAP_ANONYMOUS, -1, 0) != dest) {
+                munmap(base, mapsize); munmap(map, st.st_size); close(fd); return NULL;
+            }
+        }
+        if (mapped < ph[i].p_filesz)
+            memcpy((char*)base+at+mapped, (char*)map+ph[i].p_offset+mapped, ph[i].p_filesz-mapped);
         _copied += ph[i].p_filesz;
     }
     TLOG("  [load] %s mmap+copy %.2f MB took %.1f ms", path, (double)_copied/1048576.0, now_ms() - _tcopy);
