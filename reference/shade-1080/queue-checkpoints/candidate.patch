+/* At most one head connection. Never wait for a packet, skip ahead, or
+ * dispatch a publisher. serve_input still checks the peer and plane fd. */
+static int dispatch_head_get(const struct entry *writer,const struct entry *victim)
+{
+    if(stopping) return 0;
+    int sd=deferred>=0 ? deferred : accept4(server,NULL,NULL,SOCK_CLOEXEC|SOCK_NONBLOCK);
+    if(sd<0) return 0;
+    struct frame_frame p;
+    int eligible=0;
+    if(recv(sd,&p,sizeof(p),MSG_PEEK|MSG_DONTWAIT)==sizeof(p) &&
+       p.magic==FRAME_MAGIC && p.phase==LAYER_INPUT_GET && p.buffer_id!=writer->p.buffer_id) {
+        uint64_t nonce=((uint64_t)p.alpha_fix<<32)|p.sample;
+        for(unsigned j=0;j<INPUT_SLOTS;++j) {
+            const struct entry *e=&entries[j];
+            if(e!=victim && e->lazy && e->p.buffer_id==p.buffer_id && e->stamp.nonce==nonce &&
+               e->stamp.serial==p.serial && (e->pid!=writer->pid ||
+               (e->p.alpha_fix>>2)!=(writer->p.alpha_fix>>2))) {eligible=1;break;}
+        }
+    }
+    if(!eligible) {if(deferred<0) ++postponed;deferred=sd;return 0;}
+    deferred=-1;
+    serve_input(sd);
+    close(sd);
+    return 1;
+}
