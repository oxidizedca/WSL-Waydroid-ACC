 static struct entry entries[INPUT_SLOTS];
 static unsigned next_entry;
+/* Count placement pressure, not wall time. Existing allocations keep their
+ * slots. A lazy generation may dodge the rotating hand only once. */
+static struct entry *replacement(void)
+{
+    unsigned hand=next_entry++%INPUT_SLOTS;
+    struct entry *head=&entries[hand],*best=NULL;
+    unsigned oldest=0;
+    if(!head->tex || !head->lazy || head->spared) return head;
+    for(unsigned d=1;d<8;d++) {
+        struct entry *e=&entries[(hand+d)%INPUT_SLOTS];
+        if(!e->tex) {best=e;break;}
+        unsigned age=next_entry-e->last_use;
+        if(!e->lazy && age>=8 && age>oldest) {oldest=age;best=e;}
+    }
+    if(best) head->spared=1;
+    return best?best:head;
+}
 #include "packages.h"
