#!/bin/bash
# Installed WSL launcher. The system services load the packaged GPU components.
set -eu
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
usage() {
    printf '%s\n' 'Usage: waydroid-acc-start [-w fix|ratio] [-r WIDTHxHEIGHT] [-m pointer|touch]' \
        '  -m, --mouse pointer|touch  Mouse input mode (default: pointer).' \
        'Default: native pointer, resizable window, 1920x1080. fix: fixed window; ratio: fit without stretching.'
}
bad_arg() { echo "Invalid argument: $1" >&2; usage >&2; exit 2; }
mode=free
mouse=pointer
resolution=1920x1080
while (($#)); do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        -w|--weston) (($# >= 2)) || bad_arg "$1"; mode=$2; shift ;;
        --weston=*) mode=${1#*=} ;;
        -m|--mouse) (($# >= 2)) || bad_arg "$1"; mouse=$2; shift ;;
        --mouse=*) mouse=${1#*=} ;;
        -r|--resolution) (($# >= 2)) || bad_arg "$1"; resolution=$2; shift ;;
        --resolution=*) resolution=${1#*=} ;;
        *) bad_arg "$1" ;;
    esac
    shift
done
case $mouse in pointer|touch) ;; *) bad_arg "$mouse" ;; esac
case $mode in free|fix|ratio) ;; *) bad_arg "$mode" ;; esac
[[ $resolution =~ ^([1-9][0-9]{0,3})[xX]([1-9][0-9]{0,3})$ ]] || bad_arg "$resolution"
width=${BASH_REMATCH[1]} height=${BASH_REMATCH[2]}
((width>=128 && width<=8192 && height>=128 && height<=8192)) || bad_arg "$resolution"
((EUID==0)) || { echo 'Run with sudo.' >&2; exit 1; }
# Serialize argument changes with the container restart; do not leak this lock
# or the staged environment into the detached user session.
exec 8>/run/waydroid-acc-start.lock
flock -n 8 || { echo 'Another launch is in progress.' >&2; exit 1; }
user=$(systemctl show waydroid-acc-weston -p User --value)
LC="lxc-attach -P /var/lib/waydroid/lxc -n waydroid --"
fail() { echo "Error: $*" >&2; exit 1; }
adb_unit=waydroid-adb-local
start_adb_forward() {
    local ip="" i
    # Query the container itself: its DHCP lease can change between launches.
    for i in {1..5}; do
        ip=$(timeout 2 $LC ip -4 -o addr show dev eth0 scope global 2>/dev/null |
            awk '$3 == "inet" {split($4,a,"/"); print a[1]; exit}')
        [[ -n $ip ]] && break
        sleep 1
    done
    [[ -n $ip ]] || { echo "Could not get an IPv4 address for eth0 in the Waydroid container." >&2; return 1; }
    local proxy=/usr/lib/systemd/systemd-socket-proxyd
    [[ -x $proxy ]] || { echo "Required proxy executable not found or not executable: $proxy" >&2; return 1; }
    # This image resets adb_enabled at boot, even when developer options stay on.
    [[ $(timeout 3 $LC getprop ro.adb.secure) == 1 ]] ||
        { echo "ADB key authentication is disabled in Android. Refusing to forward ADB." >&2; return 1; }
    if [[ $(timeout 3 $LC settings get global adb_enabled) != 1 ]]; then
        [[ $(timeout 3 $LC settings get global development_settings_enabled) == 1 ]] ||
            { echo "To use ADB, enable Developer options and USB debugging in Android." >&2; return 1; }
        timeout 3 $LC settings put global adb_enabled 1 || return 1
    fi
    for i in {1..5}; do
        if timeout 1 bash -c 'exec 3<>/dev/tcp/"$1"/5555' _ "$ip" 2>/dev/null; then break; fi
        [[ $i != 5 ]] || { echo "The container ADB endpoint at $ip:5555 is not ready." >&2; return 1; }
        sleep 1
    done
    # Transient units only; stopping the container also drops the listener and existing transports.
    systemd-run --quiet --collect --unit="$adb_unit" \
        --socket-property=ListenStream=127.0.0.1:15555 \
        --socket-property=NoDelay=yes \
        --socket-property=StopPropagatedFrom=waydroid-container.service \
        -p StopPropagatedFrom=waydroid-container.service -p DynamicUser=yes \
        "$proxy" "$ip:5555" || return 1
    echo "      Windows ADB: 127.0.0.1:15555 -> $ip:5555"
}
# Use only the active release, including for installs without a source tree.
if [[ $mouse != pointer || $mode != free || $width != 1920 || $height != 1080 ]]; then
    [[ -r /usr/local/lib/wsl-waydroid-acc/current/weston/wayland-backend.so ]] ||
        fail "Custom window settings require the built version. Deploy it with 'sudo bash deploy.sh built'."
fi
cfg=/run/waydroid-acc-window.env
tmp=$(mktemp /run/.waydroid-acc-window.XXXXXXXX)
trap 'rm -f -- "$tmp"' EXIT
printf 'ACC_WINDOW_MODE=%s\nACC_WIDTH=%s\nACC_HEIGHT=%s\nACC_MOUSE_MODE=%s\n' "$mode" "$width" "$height" "$mouse" > "$tmp"
chmod 644 "$tmp"

# Close the client first; relaunch even when flags match so a previously
# dragged window returns to its requested starting size.
systemctl stop "$adb_unit.socket" "$adb_unit.service" 2>/dev/null || true
systemctl stop waydroid-container.service
mv -fT "$tmp" "$cfg"
systemctl restart waydroid-acc-weston.service
echo "[1/5] Nested Weston started (resolution: ${width}x${height}, mode: $mode, mouse: $mouse)"
echo "[2/5] Starting the Waydroid container"
systemctl start waydroid-container
sleep 4
systemctl is-active waydroid-container >/dev/null || fail "The waydroid-container service is not active."

echo "[3/5] Setting up the Waydroid network bridge"
/usr/lib/waydroid/data/scripts/waydroid-net.sh start >/dev/null 2>&1 || ip link show waydroid0 >/dev/null
ip link show waydroid0 >/dev/null 2>&1 || fail "Network bridge waydroid0 was not found."

# ---------- 3) session ----------
echo "[4/5] Starting the Waydroid session (WAYLAND_DISPLAY=wd-weston)"
if waydroid status 2>/dev/null | grep -q "Session:.*RUNNING"; then
    echo "      The session is already running."
else
    su - "$user" -c "export XDG_RUNTIME_DIR=/mnt/wslg/runtime-dir; export WAYLAND_DISPLAY=wd-weston; \
        cd ~ && setsid nohup waydroid session start > ~/wd_session.log 2>&1 < /dev/null &" \
        8>&- < /dev/null > /dev/null 2>&1
fi

BOOT=""
for i in $(seq 1 20); do
    BOOT=$(timeout 2 $LC sh -c 'getprop sys.boot_completed' 2>/dev/null | tr -d '\r')
    [ "$BOOT" = "1" ] && break
    sleep 3
done
[ "$BOOT" = "1" ] || fail "Timed out waiting for Android to boot. Check the session user's ~/wd_session.log and /var/lib/waydroid/waydroid.log."
echo "      boot_completed=1"
if ! systemctl start waydroid-acc-touch.service; then
    echo "Warning: The virtual touchscreen did not start. Mouse input and the graphical session are still available. Check 'journalctl -u waydroid-acc-touch'." >&2
fi
start_adb_forward || echo "Warning: Windows ADB forwarding is unavailable. Waydroid startup will continue." >&2

# ---------- 4) properties ----------
echo "[5/5] Setting Android properties (zero display padding)"
timeout 10 $LC sh -c 'setprop persist.waydroid.width_padding 0; setprop persist.waydroid.height_padding 0; setprop waydroid.active_apps Waydroid' 2>/dev/null || true

# ---------- status ----------
echo
echo "=== Status ==="
timeout 8 $LC sh -c 'echo -n "boot="; getprop sys.boot_completed; echo -n "display="; getprop waydroid.display_width; getprop waydroid.display_height; echo -n "sf="; pidof surfaceflinger; echo -n "sysui="; pidof com.android.systemui; echo -n "launcher="; pidof com.android.launcher3' 2>/dev/null | tr -d '\r'
echo
timeout 8 $LC wm size || true
echo "To open the Waydroid UI, run: waydroid show-full-ui"
