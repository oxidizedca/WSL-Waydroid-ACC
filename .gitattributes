*.sh text eol=lf
*.service text eol=lf
*.conf text eol=lf
*.rc text eol=lf
*.soname text eol=lf
*.sha256 text eol=lf
*.py text eol=lf
*.c text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.S text eol=lf
*.so binary
*.so.* binary
*.tar.gz filter=lfs diff=lfs merge=lfs -text
*.crate binary
runtime/* -text
runtime/services/** -text
host/egl/* -text
host/gallium/** -text
SHA256SUMS text eol=lf
# Executable scripts installed without language suffixes.
services/waydroid-acc-* text eol=lf
services/screencap text eol=lf
# KernelSU module metadata and Android properties must use Unix newlines.
system-optimize/modules/**/*.prop text eol=lf
# Preserve copied upstream notices and the byte hashes in the Digitalis notice bundle.
licenses/** -text
system-optimize/digitails/THIRD-PARTY-NOTICES.txt -text
system-optimize/digitails/NOTICE-MAP.tsv text eol=lf
system-optimize/digitails/patches/*.patch text eol=lf

# Keep inputs to the reproducible runtime archive identical on Windows checkouts.
/LICENSE text eol=lf
/THIRD_PARTY_NOTICES.md text eol=lf
/vendor/libdeflate-COPYING -text
/services/weston.ini text eol=lf
