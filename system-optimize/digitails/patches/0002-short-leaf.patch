+// The decoder still implements each accepted instruction. No nested control flow,
+// SP changes, X30 writes, atomics, syscalls or PC-relative materialization.
+bool LeafWord(uint32_t w) {
+  const unsigned rd = w & 31, rn = (w >> 5) & 31;
+  if (rd >= 30) return false;
+  if ((w & 0xbfc00000u) == 0xb9400000u) return true;  // unsigned-offset LDR W/X
+  if ((w & 0x3f800000u) == 0x11000000u) return rn != 31;  // ADD/SUB imm, no flags
+  if ((w & 0x3fe00000u) == 0x0b000000u)                 // ADD/SUB LSL
+    return (w >> 31) || !(w & (1u << 15));
+  if ((w & 0x1f200000u) == 0x0a000000u && ((w >> 29) & 3) != 3)
+    return (w >> 31) || !(w & (1u << 15));  // AND/ORR/EOR shifted
+  return false;
+}
