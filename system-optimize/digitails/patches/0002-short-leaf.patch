+Arm64LeafRecipe CaptureArm64Leaf(GuestAddr pc, GuestAddr end) {
+  Arm64LeafRecipe r{};
+  for (unsigned i = 0; i <= Arm64LeafRecipe::kMax; ++i) {
+    const unsigned span = 4 * (i + 1);
+    if (end - pc < span || (pc & 4095) + span > 4096) break;
+    uint32_t w = *ToHostAddr<const uint32_t>(pc + 4*i);
+    if (w == 0xd65f03c0u && i) { r.pc=pc; r.count=i; return r; }
+    if (i == Arm64LeafRecipe::kMax || !LeafWord(w)) break;
+    r.words[i]=w;
+  }
+  return {};
