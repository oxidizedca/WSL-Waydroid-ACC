@@ -76,6 +76,31 @@ class LiteTranslator {
 
   GuestAddr GetInsnAddr() const { return pc_; }
 
+  void SetLeafPc(GuestAddr pc) { pc_=pc; }
+  void BeginGuardedLeaf(const Arm64LeafRecipe& r) {
+    auto* slow=as_.MakeLabel();
+    auto* body=as_.MakeLabel();
+    as_.Cmpb({.base=Assembler::rbp,.disp=offsetof(ThreadState,pending_signals_status)},
+             kPendingSignalsPresent);
+    as_.Jcc(Condition::kEqual,*slow);
+    // RAX is reserved, never a mapped guest register. The slot remains
+    // stable; invalidation/gear change/wrapping replaces its 32-bit value.
+    as_.Movq(as_.rax,r.slot);
+    as_.Cmpl({.base=as_.rax},static_cast<int32_t>(r.expected));
+    as_.Jcc(Condition::kEqual,*body);
+    as_.Bind(slow);
+    ExitRegion(r.pc);
+    as_.Bind(body);
+  }
+  void LeafReturnPoll(GuestAddr pc) {
+    auto* cont=as_.MakeLabel();
+    as_.Cmpb({.base=Assembler::rbp,.disp=offsetof(ThreadState,pending_signals_status)},
+             kPendingSignalsPresent);
+    as_.Jcc(Condition::kNotEqual,*cont);
+    ExitRegion(pc);
+    as_.Bind(cont);
+  }
+
