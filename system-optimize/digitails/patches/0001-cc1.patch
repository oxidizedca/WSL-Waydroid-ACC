+  // CMP Wn,Wm; B.{EQ,NE,CS,CC} forward; SUBS immediate. No faulting guest
+  // operation or dispatch on the fall-through before SUBS replaces all NZCV.
+  void EmitCmpBranchBeforeSubs(unsigned rn, unsigned rm, unsigned cond, GuestAddr target) {
+    auto lhs = GetReg(rn);
+    auto rhs = GetReg(rm);
+    if (!success()) return;
+    constexpr Condition not_taken[] = {Condition::kNotEqual, Condition::kEqual,
+                                      Condition::kCarry, Condition::kNotCarry};
+    auto* cont = as_.MakeLabel();
+    as_.Cmpl(lhs, rhs);
+    as_.Jcc(not_taken[cond], *cont);
+    EmitStoreArmNZCV(true);  // taken target observes original CMP flags
+    ExitRegion(target);
+    as_.Bind(cont);
+  }
